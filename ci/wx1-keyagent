#!/bin/sh
# Starts wx1-keyagent: nginx with the agent built in. What meta's meta-http
# does, so the release needs nothing from meta at run time.
#
# The agent runs inside nginx's master, writes the real configuration from
# the program (ports, TLS, workers) and has nginx read it. So this writes
# only enough for nginx to start.
#
#   WX_STATE_DIR   nginx's working directory (default /var/lib/wx1-keyagent)
#   everything else: the WX_* settings in doc/betrieb.md
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
state=${WX_STATE_DIR:-/var/lib/wx1-keyagent}

mkdir -p "$state/conf" "$state/logs"
chmod 700 "$state"

cat > "$state/conf/nginx.conf" <<CONF
# Written by bin/wx1-keyagent, and replaced by the agent a moment later.
daemon off;
error_log stderr info;
pid logs/meta.pid;

events { worker_connections 64; }

http { }
CONF

# OpenSSL is linked in and was built with a directory of its own, so it does
# not read this host's openssl.cnf; the trust store is this host's, found
# where each distribution keeps it
if [ -z "${SSL_CERT_FILE:-}" ]; then
  for ca in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
            /etc/ssl/ca-bundle.pem /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/cert.pem; do
    if [ -r "$ca" ]; then
      export SSL_CERT_FILE="$ca"
      break
    fi
  done
fi
[ -n "${SSL_CERT_FILE:-}" ] || echo "wx1-keyagent: no CA bundle found; set SSL_CERT_FILE" >&2

exec "$here/sbin/nginx" -c "$state/conf/nginx.conf" -p "$state"
