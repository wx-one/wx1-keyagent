# The released binary in a plain ubuntu:24.04 - nothing of meta, no compiler:
# what a customer runs, as an image. Built from out/<release>.tar.gz.
#   docker build -f ci/Dockerfile.release --build-arg RELEASE=<name> -t wx/wx1-keyagent:<v> out
FROM ubuntu:24.04
ARG RELEASE
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libpq5 libcurl4t64 libssl3t64 libyaml-0-2 libpcre2-8-0 zlib1g ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ADD ${RELEASE}.tar.gz /opt/
RUN mv /opt/${RELEASE} /opt/wx1-keyagent \
    && useradd --system --uid 999 --home /var/lib/wx1-keyagent wx1ka \
    && mkdir -p /var/lib/wx1-keyagent && chown wx1ka /var/lib/wx1-keyagent
USER wx1ka
ENV WX_STATE_DIR=/var/lib/wx1-keyagent
ENTRYPOINT ["/opt/wx1-keyagent/bin/wx1-keyagent"]
